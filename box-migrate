#!/usr/bin/env bash
#
# Toolbox Migrate
# Seed a new destination Toolbox container with packages, repositories,
# and caches from an existing source container.

set -Eeuo pipefail

VERSION="0.9.5"

SOURCE=""
DEST=""
DISTRO=""
RELEASE=""
CUSTOM_IMAGE=""
DRY_RUN=0
INCLUDE_REPOS=1
INCLUDE_CACHE=1
REBUILD_LOCAL=0
CUSTOM_WORKDIR=""
WORKDIR=""
DEST_CREATED=0

log()  { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[OK]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; exit 1; }

on_err() {
    local exit_code=$?
    local line_no=$1
    printf '\033[1;31m[ERROR]\033[0m Command failed at line %s (exit code %s).\n' "$line_no" "$exit_code" >&2
    if [[ "$DEST_CREATED" -eq 1 && -n "$DEST" ]]; then
        printf '\033[1;33m[HINT]\033[0m Destination container "%s" was already created. Remove it with: toolbox rm -f %s\n' "$DEST" "$DEST" >&2
    fi
    exit "$exit_code"
}
trap 'on_err $LINENO' ERR

tar_has_files() {
    local archive="$1"
    [[ -s "$archive" ]] && tar -tzf "$archive" 2>/dev/null | grep -q '[^/]$'
}

usage() {
    local cmd
    cmd="$(basename "$0")"
    cat <<USAGE
Toolbox Migrate v$VERSION

Usage:
  $cmd SOURCE DESTINATION [OPTIONS]

Options:
  -d, --distro DISTRO      Supported distribution family:
                           fedora, rhel, ubuntu, arch (optional if --image is specified)
  -r, --release RELEASE    Distribution release (required for versioned distros; omitted for Arch)
  -i, --image IMAGE        Custom container image reference for non-default images
  -n, --dry-run            Simulate migration without modifying container state
  -R, --repos              Migrate custom repositories and GPG keys, normalizing release variables (default: enabled)
      --no-repos           Disable custom repository migration
  -C, --cache              Migrate local package caches for offline or manual packages (default: enabled)
      --no-cache           Disable local package cache migration
  -L, --rebuild-local      Rebuild and migrate standalone local RPMs (@commandline) via sudo rpmrebuild
                           (DNF only; installs rpmrebuild in source container if missing)
  -w, --workdir DIR        Working directory for manifests, archives, and migration reports
                           (default: ~/box-migrate-SOURCE-to-DESTINATION)
  -h, --help               Display usage information and exit

Supported Distributions & Package Managers:
  Toolbox natively supports fedora, rhel, ubuntu, and arch (plus any compatible derivatives).
  Source and destination containers must use the same package manager family.

Examples:
  $cmd fedora-toolbox-44 fedora-toolbox-45 -d fedora -r 45 --dry-run
  $cmd rockylinux-source rockylinux-dest -i quay.io/rockylinux/rockylinux:9
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--distro)
            DISTRO="${2:?Missing distribution argument}"
            shift 2
            ;;
        -r|--release)
            RELEASE="${2:?Missing release argument}"
            shift 2
            ;;
        -i|--image)
            CUSTOM_IMAGE="${2:?Missing image reference argument}"
            shift 2
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        -R|--repos)
            INCLUDE_REPOS=1
            shift
            ;;
        --no-repos)
            INCLUDE_REPOS=0
            shift
            ;;
        -C|--cache)
            INCLUDE_CACHE=1
            shift
            ;;
        --no-cache)
            INCLUDE_CACHE=0
            shift
            ;;
        -L|--rebuild-local)
            REBUILD_LOCAL=1
            shift
            ;;
        -w|--workdir)
            CUSTOM_WORKDIR="${2:?Missing working directory argument}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ -z "$SOURCE" ]]; then
                SOURCE="$1"
            elif [[ -z "$DEST" ]]; then
                DEST="$1"
            else
                fail "Unexpected argument: $1"
            fi
            shift
            ;;
    esac
done

[[ -n "$SOURCE" && -n "$DEST" ]] || { usage; exit 1; }
[[ -n "$DISTRO" || -n "$CUSTOM_IMAGE" ]] || fail "Either destination distribution (-d/--distro) or custom image (-i/--image) must be specified."

if [[ -n "$DISTRO" ]]; then
    is_default_distro=0
    case "$DISTRO" in
        fedora|rhel|ubuntu|arch)
            is_default_distro=1
            ;;
    esac

    if [[ "$is_default_distro" -eq 0 && -z "$CUSTOM_IMAGE" ]]; then
        if [[ -t 0 ]]; then
            warn "Distribution '$DISTRO' is not natively supported by default."
            read -rp "Enter a custom container image reference (e.g., quay.io/rockylinux/rockylinux:9): " CUSTOM_IMAGE
            [[ -n "$CUSTOM_IMAGE" ]] || fail "Custom container image reference is required for distribution '$DISTRO'."
        else
            fail "Distribution '$DISTRO' is not supported by default. Use --image to specify a custom container image."
        fi
    fi

    # Conditional release validation: rolling distros (like arch) omit -r; versioned distros require it.
    if [[ "$DISTRO" == "arch" ]]; then
        if [[ -n "$RELEASE" ]]; then
            warn "Release argument '$RELEASE' is ignored for rolling-release distribution '$DISTRO'."
            RELEASE=""
        fi
    else
        if [[ -z "$CUSTOM_IMAGE" ]]; then
            [[ -n "$RELEASE" ]] || fail "Destination release is required (-r/--release) for versioned distribution '$DISTRO'."
        fi
    fi
fi

command -v toolbox >/dev/null || fail "Toolbox is not installed."
command -v podman >/dev/null || fail "Podman is not installed."
[[ "$SOURCE" != "$DEST" ]] || fail "Source and destination containers must have distinct names."

if [[ -n "$CUSTOM_WORKDIR" ]]; then
    WORKDIR="${CUSTOM_WORKDIR%/}"
    [[ -n "$WORKDIR" ]] || fail "Invalid working directory path: $CUSTOM_WORKDIR"
else
    BASE_WORKDIR="$HOME/box-migrate-${SOURCE}-to-${DEST}"
    WORKDIR="$BASE_WORKDIR"
    if [[ -d "$WORKDIR" ]]; then
        i=1
        while [[ -d "${BASE_WORKDIR}-${i}" ]]; do
            ((++i))
        done
        WORKDIR="${BASE_WORKDIR}-${i}"
    fi
fi
mkdir -p "$WORKDIR"

PACKAGES="$WORKDIR/packages.txt"
REPORT="$WORKDIR/report.txt"
SPECIAL_CASES="$WORKDIR/special-cases.txt"
REPOS="$WORKDIR/repositories.tar.gz"
PKG_CACHE="$WORKDIR/package-cache.tar.gz"
LOCAL_RPMS_LIST="$WORKDIR/local_rpms.txt"
LOCAL_RPMS_NAMES="$WORKDIR/local_rpms_names.txt"
LOCAL_RPMS_DIR="$WORKDIR/local-rpms"
REBUILT_OK_LIST="$WORKDIR/rebuilt_ok.txt"
REBUILT_FAIL_LIST="$WORKDIR/rebuilt_fail.txt"
MISSING_PKGS_LIST="$WORKDIR/missing_pkgs.txt"
MISSING_SO_LIST="$WORKDIR/missing_libs.txt"
RESOLVED_SO_PKGS_LIST="$WORKDIR/resolved_lib_pkgs.txt"

: > "$REBUILT_OK_LIST"
: > "$REBUILT_FAIL_LIST"
: > "$MISSING_PKGS_LIST"
: > "$MISSING_SO_LIST"
: > "$RESOLVED_SO_PKGS_LIST"

DRY_RUN_LABEL=""
if [[ "$DRY_RUN" -eq 1 ]]; then
    DRY_RUN_LABEL="[DRY-RUN]"
fi

log "Toolbox Migrate v$VERSION${DRY_RUN_LABEL:+ $DRY_RUN_LABEL}"
log "Source container: $SOURCE"
log "Destination container: $DEST"
log "Working directory: $WORKDIR"
log "Configuration -> Repositories: $INCLUDE_REPOS | Cache: $INCLUDE_CACHE | Rebuild local: $REBUILD_LOCAL${CUSTOM_IMAGE:+ | Custom Image: $CUSTOM_IMAGE}"

toolbox list -c | awk 'NR>1 {print $2}' | grep -Fxq "$SOURCE" \
    || fail "Source container not found: $SOURCE"

if toolbox list -c | awk 'NR>1 {print $2}' | grep -Fxq "$DEST"; then
    fail "Destination container already exists: $DEST"
fi

log "Inspecting source distribution environment..."
OS_INFO=$(toolbox run --container "$SOURCE" -- cat /etc/os-release)
SOURCE_ID=$(printf '%s\n' "$OS_INFO" | sed -n 's/^ID=//p' | tr -d '"' | tr -d "'")
SOURCE_LIKE=$(printf '%s\n' "$OS_INFO" | sed -n 's/^ID_LIKE=//p' | tr -d '"' | tr -d "'")
SOURCE_VERSION=$(printf '%s\n' "$OS_INFO" | sed -n 's/^VERSION_ID=//p' | tr -d '"' | tr -d "'")
SOURCE_CODENAME=$(printf '%s\n' "$OS_INFO" | sed -n 's/^VERSION_CODENAME=//p' | tr -d '"' | tr -d "'")

# Ancestry-based package manager detection via ID and ID_LIKE
if [[ "$SOURCE_ID" =~ (fedora|rhel|centos|rocky|almalinux|oracle) || "$SOURCE_LIKE" =~ (fedora|rhel) ]]; then
    PM="dnf"
elif [[ "$SOURCE_ID" =~ (ubuntu|debian) || "$SOURCE_LIKE" =~ debian ]]; then
    PM="apt"
elif [[ "$SOURCE_ID" =~ (arch|manjaro) || "$SOURCE_LIKE" =~ arch ]]; then
    PM="pacman"
else
    fail "Unable to determine package manager family for source distribution: $SOURCE_ID (ID_LIKE: $SOURCE_LIKE)"
fi

log "Detected Source ID: $SOURCE_ID, Package Manager: $PM"

log "Exporting source package list..."
case "$PM" in
    dnf)
        toolbox run --container "$SOURCE" -- \
            dnf repoquery --userinstalled --qf '%{name}\t%{name}.%{arch}\t%{from_repo}\n' \
            | sed 's/\\t/\t/g' \
            > "$WORKDIR/source_repoquery.tsv"
        cut -f1 "$WORKDIR/source_repoquery.tsv" | sort -u > "$WORKDIR/source_all.txt"
        awk -F'\t' '$3 == "@commandline" {print $2}' "$WORKDIR/source_repoquery.tsv" \
            | sort -u > "$LOCAL_RPMS_LIST" || true
        awk -F'\t' '$3 == "@commandline" {print $1}' "$WORKDIR/source_repoquery.tsv" \
            | sort -u > "$LOCAL_RPMS_NAMES" || true
        ;;
    apt)
        toolbox run --container "$SOURCE" -- \
            apt-mark showmanual > "$WORKDIR/source_all.txt"
        ;;
    pacman)
        toolbox run --container "$SOURCE" -- \
            pacman -Qqe > "$WORKDIR/source_all.txt"
        ;;
esac

if [[ "$REBUILD_LOCAL" -eq 1 && "$PM" != "dnf" ]]; then
    warn "Option --rebuild-local is supported exclusively for DNF-based distributions; ignoring."
    REBUILD_LOCAL=0
fi

if [[ "$INCLUDE_REPOS" -eq 1 ]]; then
    log "Exporting repository configurations..."
    case "$PM" in
        dnf)
            toolbox run --container "$SOURCE" -- \
                bash -c 'tar czf - --ignore-failed-read --exclude="fedora.repo" --exclude="fedora-updates.repo" /etc/yum.repos.d /etc/pki/rpm-gpg 2>/dev/null' > "$REPOS" || true
            ;;
        apt)
            toolbox run --container "$SOURCE" -- \
                bash -c 'tar czf - --ignore-failed-read --exclude="ubuntu.sources" /etc/apt/sources.list.d /etc/apt/keyrings /usr/share/keyrings 2>/dev/null' > "$REPOS" || true
            ;;
        pacman)
            toolbox run --container "$SOURCE" -- \
                bash -c 'tar czf - --ignore-failed-read /etc/pacman.conf /etc/pacman.d 2>/dev/null' > "$REPOS" || true
            ;;
    esac
fi

if [[ "$INCLUDE_CACHE" -eq 1 ]]; then
    log "Exporting local package cache..."
    case "$PM" in
        dnf)
            toolbox run --container "$SOURCE" -- \
                bash -c 'tar czf - --ignore-failed-read /var/cache/libdnf5 /var/cache/dnf 2>/dev/null' > "$PKG_CACHE" || true
            ;;
        apt)
            toolbox run --container "$SOURCE" -- \
                bash -c 'shopt -s nullglob; files=(/var/cache/apt/archives/*.deb); (( ${#files[@]} )) && tar czf - "${files[@]}" 2>/dev/null' > "$PKG_CACHE" || true
            ;;
        pacman)
            toolbox run --container "$SOURCE" -- \
                bash -c 'tar czf - --ignore-failed-read /var/cache/pacman/pkg 2>/dev/null' > "$PKG_CACHE" || true
            ;;
    esac
fi

if [[ "$REBUILD_LOCAL" -eq 1 && -s "$LOCAL_RPMS_LIST" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "[DRY-RUN] Would rebuild the following standalone local RPMs from $SOURCE:"
        sed 's/^/  - /' "$LOCAL_RPMS_LIST"
    else
        log "Rebuilding standalone local RPMs from source container..."
        mkdir -p "$LOCAL_RPMS_DIR"
        if ! toolbox run --container "$SOURCE" -- command -v rpmrebuild >/dev/null 2>&1; then
            log "Installing rpmrebuild package in source container $SOURCE..."
            toolbox run --container "$SOURCE" -- sudo dnf install -y rpmrebuild
        fi
        while IFS= read -r local_pkg; do
            [[ -z "$local_pkg" ]] && continue
            log "Rebuilding local RPM: $local_pkg"
            if rebuild_out=$(toolbox run --container "$SOURCE" -- \
                sudo rpmrebuild -bn --define '_binary_payload w2.zstdio' --directory="$LOCAL_RPMS_DIR" "$local_pkg" </dev/null 2>&1); then
                ok "Successfully rebuilt local RPM: $local_pkg"
                echo "$local_pkg" >> "$REBUILT_OK_LIST"
            else
                err_line=$(printf '%s\n' "$rebuild_out" | grep -E 'ERROR|error:' | tail -n 1 || true)
                warn "Failed to rebuild local RPM: $local_pkg ${err_line:+($err_line)}"
                echo "$local_pkg${err_line:+ — $err_line}" >> "$REBUILT_FAIL_LIST"
            fi
        done < "$LOCAL_RPMS_LIST"
    fi
fi

# Pre-flight inspection for custom images to prevent wasted downloads/storage on mismatches
if [[ -n "$CUSTOM_IMAGE" ]]; then
    log "Pre-flight inspecting custom image compatibility: $CUSTOM_IMAGE"
    DEST_INFO=$(podman run --rm "$CUSTOM_IMAGE" cat /etc/os-release 2>/dev/null || fail "Unable to pull or inspect custom image: $CUSTOM_IMAGE")
    DEST_ID=$(printf '%s\n' "$DEST_INFO" | sed -n 's/^ID=//p' | tr -d '"' | tr -d "'")
    DEST_LIKE=$(printf '%s\n' "$DEST_INFO" | sed -n 's/^ID_LIKE=//p' | tr -d '"' | tr -d "'")

    if [[ "$DEST_ID" =~ (fedora|rhel|centos|rocky|almalinux|oracle) || "$DEST_LIKE" =~ (fedora|rhel) ]]; then
        DEST_PM="dnf"
    elif [[ "$DEST_ID" =~ (ubuntu|debian) || "$DEST_LIKE" =~ debian ]]; then
        DEST_PM="apt"
    elif [[ "$DEST_ID" =~ (arch|manjaro) || "$DEST_LIKE" =~ arch ]]; then
        DEST_PM="pacman"
    else
        fail "Unsupported destination package manager family for image ID: $DEST_ID (ID_LIKE: $DEST_LIKE)"
    fi
    log "Pre-flight check passed. Target Package Manager: $DEST_PM"

    if [[ "$PM" != "$DEST_PM" ]]; then
        fail "Package manager mismatch ($PM vs $DEST_PM). Cross-family migrations cannot automatically install packages. Aborting before container creation."
    fi
fi

DEST_CODENAME=""
CREATE_CMD=(toolbox create --container "$DEST")
if [[ -n "$CUSTOM_IMAGE" ]]; then
    [[ -n "$DISTRO" || -n "$RELEASE" ]] && warn "Ignoring --distro/--release arguments because custom image '--image $CUSTOM_IMAGE' takes precedence."
    CREATE_CMD+=(--image "$CUSTOM_IMAGE")
else
    [[ -n "$DISTRO" ]] && CREATE_CMD+=(--distro "$DISTRO")
    [[ -n "$RELEASE" ]] && CREATE_CMD+=(--release "$RELEASE")
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
    log "[DRY-RUN] Would run: ${CREATE_CMD[*]}"
    if [[ -z "$CUSTOM_IMAGE" ]]; then
        DEST_PM="$PM"
    fi
    touch "$WORKDIR/dest_installed.txt"
else
    log "Creating destination container..."
    "${CREATE_CMD[@]}"
    DEST_CREATED=1
    ok "Destination container created successfully."

    if [[ -z "$CUSTOM_IMAGE" ]]; then
        DEST_INFO=$(toolbox run --container "$DEST" -- cat /etc/os-release)
        DEST_ID=$(printf '%s\n' "$DEST_INFO" | sed -n 's/^ID=//p' | tr -d '"' | tr -d "'")
        DEST_LIKE=$(printf '%s\n' "$DEST_INFO" | sed -n 's/^ID_LIKE=//p' | tr -d '"' | tr -d "'")
        DEST_CODENAME=$(printf '%s\n' "$DEST_INFO" | sed -n 's/^VERSION_CODENAME=//p' | tr -d '"' | tr -d "'")

        if [[ "$DEST_ID" =~ (fedora|rhel|centos|rocky|almalinux|oracle) || "$DEST_LIKE" =~ (fedora|rhel) ]]; then
            DEST_PM="dnf"
        elif [[ "$DEST_ID" =~ (ubuntu|debian) || "$DEST_LIKE" =~ debian ]]; then
            DEST_PM="apt"
        elif [[ "$DEST_ID" =~ (arch|manjaro) || "$DEST_LIKE" =~ arch ]]; then
            DEST_PM="pacman"
        else
            fail "Unsupported destination package manager family for distribution ID: $DEST_ID (ID_LIKE: $DEST_LIKE)"
        fi
    fi
    log "Detected Destination ID: ${DEST_ID:-custom}, Package Manager: $DEST_PM"
fi

if [[ "$PM" != "$DEST_PM" ]]; then
    fail "Package manager mismatch ($PM vs $DEST_PM). Cross-family migrations cannot automatically install packages."
fi

if [[ "$INCLUDE_REPOS" -eq 1 ]] && tar_has_files "$REPOS"; then
    log "Restoring and sanitizing repository configurations in destination..."
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "[DRY-RUN] Would restore repositories and normalize release variables"
    else
        toolbox run --container "$DEST" -- \
            sudo bash -c 'tar xzf - -C /' < "$REPOS" 2>/dev/null || true

        if [[ "$DEST_PM" == "dnf" && "$SOURCE_VERSION" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
            ESCAPED_VER="${SOURCE_VERSION//./\\.}"
            MAJOR_VER="${SOURCE_VERSION%%.*}"
            toolbox run --container "$DEST" -- \
                sudo bash -c "sed -i -E '/^(baseurl|mirrorlist|metalink)=/ s/(fedora[-/]|fc|el)(${ESCAPED_VER}|${MAJOR_VER})([-/&]|$)/\1\$releasever\3/g' /etc/yum.repos.d/*.repo 2>/dev/null || true"
        fi

        if [[ "$DEST_PM" == "apt" && "$SOURCE_CODENAME" =~ ^[a-z0-9-]+$ && "$DEST_CODENAME" =~ ^[a-z0-9-]+$ && "$SOURCE_CODENAME" != "$DEST_CODENAME" ]]; then
            toolbox run --container "$DEST" -- \
                sudo bash -c "sed -i -E 's/\b${SOURCE_CODENAME}\b/${DEST_CODENAME}/g' /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true"
        fi
    fi
else
    log "Repository migration skipped or no custom configurations found."
fi

if [[ "$INCLUDE_CACHE" -eq 1 ]] && tar_has_files "$PKG_CACHE"; then
    log "Restoring local package cache into destination..."
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "[DRY-RUN] Would restore local package cache into container $DEST"
    else
        toolbox run --container "$DEST" -- \
            sudo bash -c 'tar xzf - -C /' < "$PKG_CACHE" 2>/dev/null || true
    fi
else
    log "Package cache migration skipped or no cached files found."
fi

log "Filtering out base packages already present in destination..."
if [[ "$DRY_RUN" -eq 0 ]]; then
    case "$DEST_PM" in
        dnf)
            toolbox run --container "$DEST" -- \
                dnf repoquery --installed --qf '%{name}\n' \
                | sed 's/\\n/\n/g' \
                > "$WORKDIR/dest_installed.txt"
            ;;
        apt)
            toolbox run --container "$DEST" -- \
                dpkg-query -W -f='${Package}\n' \
                > "$WORKDIR/dest_installed.txt"
            ;;
        pacman)
            toolbox run --container "$DEST" -- \
                pacman -Qq > "$WORKDIR/dest_installed.txt"
            ;;
    esac
fi

if [[ "$REBUILD_LOCAL" -eq 1 && -s "$LOCAL_RPMS_NAMES" ]]; then
    comm -23 <(sort -u "$WORKDIR/source_all.txt") <(sort -u "$WORKDIR/dest_installed.txt" "$LOCAL_RPMS_NAMES") \
        > "$PACKAGES"
else
    comm -23 <(sort -u "$WORKDIR/source_all.txt") <(sort -u "$WORKDIR/dest_installed.txt") \
        > "$PACKAGES"
fi

mapfile -t PKG_ARRAY < <(grep -v '^[[:space:]]*$' "$PACKAGES" || true)
PACKAGE_COUNT=${#PKG_ARRAY[@]}
log "Identified $PACKAGE_COUNT additional repository packages to migrate."

if [[ "$PACKAGE_COUNT" -gt 0 ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "[DRY-RUN] Would install the following packages in $DEST:"
        printf '  - %s\n' "${PKG_ARRAY[@]}"
    else
        log "Installing additional packages in destination container..."
        case "$DEST_PM" in
            dnf)
                if ! toolbox run --container "$DEST" -- \
                    sudo dnf install -y --skip-unavailable --skip-broken "${PKG_ARRAY[@]}" \
                    2>&1 | tee -a "$REPORT"; then
                    warn "Batch DNF transaction encountered issues; retrying packages individually..."
                    for pkg in "${PKG_ARRAY[@]}"; do
                        [[ -z "$pkg" ]] && continue
                        toolbox run --container "$DEST" -- \
                            sudo dnf install -y --skip-unavailable --skip-broken "$pkg" \
                            </dev/null 2>&1 | tee -a "$REPORT" || true
                    done
                fi
                ;;
            apt)
                toolbox run --container "$DEST" -- sudo apt-get update \
                    2>&1 | tee "$REPORT" || warn "apt-get update encountered repository issues; proceeding with available sources."
                VALID_APT_PKGS=()
                for pkg in "${PKG_ARRAY[@]}"; do
                    cand=$(toolbox run --container "$DEST" -- apt-cache policy "$pkg" </dev/null 2>/dev/null \
                        | awk '/Candidate:/ {print $2; exit}' || true)
                    if [[ -n "$cand" && "$cand" != "(none)" ]]; then
                        VALID_APT_PKGS+=("$pkg")
                    else
                        printf 'E: Unable to locate package %s\n' "$pkg" | tee -a "$REPORT" >&2
                    fi
                done
                if [[ "${#VALID_APT_PKGS[@]}" -gt 0 ]]; then
                    toolbox run --container "$DEST" -- \
                        sudo apt-get install -y --no-install-recommends "${VALID_APT_PKGS[@]}" \
                        2>&1 | tee -a "$REPORT" || true
                fi
                ;;
            pacman)
                toolbox run --container "$DEST" -- sudo pacman -Sy --noconfirm \
                    2>&1 | tee "$REPORT" || warn "pacman -Sy encountered synchronization issues; proceeding with available sources."
                VALID_PACMAN_PKGS=()
                for pkg in "${PKG_ARRAY[@]}"; do
                    if toolbox run --container "$DEST" -- pacman -Si "$pkg" </dev/null >/dev/null 2>&1; then
                        VALID_PACMAN_PKGS+=("$pkg")
                    else
                        printf 'error: target not found: %s\n' "$pkg" | tee -a "$REPORT" >&2
                    fi
                done
                if [[ "${#VALID_PACMAN_PKGS[@]}" -gt 0 ]]; then
                    toolbox run --container "$DEST" -- \
                        sudo pacman -S --needed --noconfirm --asexplicit \
                        "${VALID_PACMAN_PKGS[@]}" 2>&1 | tee -a "$REPORT" || true
                fi
                ;;
        esac
    fi
fi

if [[ "$REBUILD_LOCAL" -eq 1 && "$DRY_RUN" -eq 0 && -d "$LOCAL_RPMS_DIR" ]]; then
    mapfile -t REBUILT_FILES < <(find "$LOCAL_RPMS_DIR" -type f -name '*.rpm' | sort)
    if [[ "${#REBUILT_FILES[@]}" -gt 0 ]]; then
        log "Installing ${#REBUILT_FILES[@]} reconstructed local RPM(s) in destination..."
        toolbox run --container "$DEST" -- \
            sudo dnf install -y --skip-unavailable --skip-broken "${REBUILT_FILES[@]}" \
            2>&1 | tee -a "$REPORT" || true

        # Detect unrecorded dynamic library dependencies on files owned by rebuilt RPMs
        for rpm_file in "${REBUILT_FILES[@]}"; do
            rpm_name=$(rpm -qp --queryformat '%{NAME}\n' "$rpm_file" 2>/dev/null || true)
            [[ -z "$rpm_name" ]] && continue
            toolbox run --container "$DEST" -- bash -c '
                rpm -ql "'"$rpm_name"'" 2>/dev/null | while IFS= read -r f; do
                    [[ -f "$f" && -x "$f" ]] || [[ "$f" == *.so* ]] || continue
                    ldd "$f" 2>/dev/null | awk "/=> not found/ {print \$1}"
                done
            ' >> "$MISSING_SO_LIST" || true
        done
        sort -u -o "$MISSING_SO_LIST" "$MISSING_SO_LIST"

        if [[ -s "$MISSING_SO_LIST" ]]; then
            warn "Detected missing shared libraries for rebuilt RPMs; resolving providers..."
            while IFS= read -r lib_soname; do
                [[ -z "$lib_soname" ]] && continue
                prov=$(toolbox run --container "$DEST" -- \
                    dnf repoquery --whatprovides "*/$lib_soname" --qf '%{name}\n' 2>/dev/null \
                    | sort -u | head -n 1 || true)
                if [[ -n "$prov" ]]; then
                    printf '%s -> %s\n' "$lib_soname" "$prov" >> "$RESOLVED_SO_PKGS_LIST"
                else
                    printf '%s -> (no provider found)\n' "$lib_soname" >> "$RESOLVED_SO_PKGS_LIST"
                fi
            done < "$MISSING_SO_LIST"

            mapfile -t SO_INSTALL_PKGS < <(awk -F' -> ' '$2 != "" && $2 != "(no provider found)" {print $2}' "$RESOLVED_SO_PKGS_LIST" | sort -u || true)
            if [[ "${#SO_INSTALL_PKGS[@]}" -gt 0 ]]; then
                log "Installing ${#SO_INSTALL_PKGS[@]} shared-library provider package(s) in destination..."
                toolbox run --container "$DEST" -- \
                    sudo dnf install -y --skip-unavailable --skip-broken "${SO_INSTALL_PKGS[@]}" \
                    2>&1 | tee -a "$REPORT" || true
            fi
        fi
    fi
fi

describe_missing_pkg() {
    local pkg="$1"
    case "$PM" in
        dnf)
            local info repo url summary
            info=$(toolbox run --container "$SOURCE" -- \
                dnf repoquery --installed --qf '%{from_repo}\t%{url}\t%{summary}' "$pkg" </dev/null 2>/dev/null \
                | sed 's/\\t/\t/g' | head -n 1 || true)
            if [[ -n "$info" ]]; then
                IFS=$'\t' read -r repo url summary <<< "$info"
                echo "  - $pkg"
                echo "      Source repo: ${repo:-unknown}"
                echo "      URL:         ${url:-none}"
                echo "      Summary:     ${summary:-none}"
            else
                echo "  - $pkg (metadata unavailable in source container)"
            fi
            ;;
        apt)
            local info url summary
            info=$(toolbox run --container "$SOURCE" -- \
                dpkg-query -W -f='${Homepage}|${binary:Summary}\n' "$pkg" </dev/null 2>/dev/null | head -n 1 || true)
            if [[ -n "$info" ]]; then
                IFS='|' read -r url summary <<< "$info"
                echo "  - $pkg"
                echo "      URL:     ${url:-none}"
                echo "      Summary: ${summary:-none}"
            else
                echo "  - $pkg"
            fi
            ;;
        pacman)
            local url summary
            url=$(toolbox run --container "$SOURCE" -- pacman -Qi "$pkg" </dev/null 2>/dev/null | sed -n 's/^URL[[:space:]]*:[[:space:]]*//p' | head -n 1 || true)
            summary=$(toolbox run --container "$SOURCE" -- pacman -Qi "$pkg" </dev/null 2>/dev/null | sed -n 's/^Description[[:space:]]*:[[:space:]]*//p' | head -n 1 || true)
            echo "  - $pkg"
            echo "      URL:     ${url:-none}"
            echo "      Summary: ${summary:-none}"
            ;;
    esac
}

OTHER_ISSUES=""
{
    echo "=== Toolbox Migration Special Cases & Skipped Packages Report ==="
    echo "Timestamp: $(date)"
    echo "Source: $SOURCE -> Destination: $DEST (Dry-run: $DRY_RUN)"
    echo "Configuration -> Repos: $INCLUDE_REPOS | Cache: $INCLUDE_CACHE | Rebuild local: $REBUILD_LOCAL${CUSTOM_IMAGE:+ | Custom Image: $CUSTOM_IMAGE}"
    echo ""
    echo "[Unavailable / Missing Packages & Details]:"
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "Dry-run mode enabled: No package installation was executed."
    elif [[ -f "$REPORT" ]]; then
        grep -E "No match for argument:|Unable to locate package |has no installation candidate|target not found: " "$REPORT" \
            | sed -E "s/.*(No match for argument: |Unable to locate package |Package '|target not found: )//; s/' has no installation candidate//" \
            | awk '{print $1}' | sort -u > "$MISSING_PKGS_LIST" || true

        OTHER_ISSUES=$(grep -E "Failed to resolve|conflicting requests|broken packages|not installable" "$REPORT" || true)

        if [[ -s "$MISSING_PKGS_LIST" ]]; then
            while IFS= read -r missing_pkg; do
                [[ -z "$missing_pkg" ]] && continue
                describe_missing_pkg "$missing_pkg"
            done < "$MISSING_PKGS_LIST"
        fi

        if [[ -n "$OTHER_ISSUES" ]]; then
            echo ""
            echo "[Dependency / Transaction Issues]:"
            printf '%s\n' "$OTHER_ISSUES"
        fi

        if [[ ! -s "$MISSING_PKGS_LIST" && -z "$OTHER_ISSUES" ]]; then
            echo "None detected."
        fi
    else
        echo "No installation report generated."
    fi
    if [[ "$PM" == "dnf" ]]; then
        echo ""
        if [[ "$REBUILD_LOCAL" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
            echo "[External / Local RPMs (Successfully Rebuilt via rpmrebuild)]:"
            if [[ -s "$REBUILT_OK_LIST" ]]; then
                cat "$REBUILT_OK_LIST"
            else
                echo "None."
            fi
            if [[ -s "$REBUILT_FAIL_LIST" ]]; then
                echo ""
                echo "[External / Local RPMs (Rebuild Failed — Manual Reinstallation Required)]:"
                cat "$REBUILT_FAIL_LIST"
            fi
            if [[ -s "$RESOLVED_SO_PKGS_LIST" ]]; then
                echo ""
                echo "[Rebuilt RPM Shared Library Resolution]:"
                cat "$RESOLVED_SO_PKGS_LIST"
            fi
        else
            echo "[External / Local RPMs (Installed Without a Repository — Reinstall Manually or Use --rebuild-local)]:"
            if [[ -s "$LOCAL_RPMS_LIST" ]]; then
                cat "$LOCAL_RPMS_LIST"
            else
                echo "None detected."
            fi
        fi
    fi
} > "$SPECIAL_CASES"

HAS_WARNINGS=0
if [[ "$DRY_RUN" -eq 0 ]]; then
    [[ -s "$MISSING_PKGS_LIST" || -n "$OTHER_ISSUES" || -s "$REBUILT_FAIL_LIST" || -s "$MISSING_SO_LIST" ]] && HAS_WARNINGS=1
    [[ "$PM" == "dnf" && "$REBUILD_LOCAL" -eq 0 && -s "$LOCAL_RPMS_LIST" ]] && HAS_WARNINGS=1
fi

ok "Migration process completed."

echo
echo "=================================================="
echo "        MIGRATION SUMMARY & SPECIAL CASES         "
echo "=================================================="
echo "Working directory:     $WORKDIR"
echo "Package manifest:      $PACKAGES"
echo "Full installation log: $REPORT"
echo "Special cases log:     $SPECIAL_CASES"
echo "--------------------------------------------------"
if [[ -s "$SPECIAL_CASES" ]]; then
    while IFS= read -r line; do
        log "$line"
    done < "$SPECIAL_CASES"
fi
echo "--------------------------------------------------"
if [[ "$HAS_WARNINGS" -eq 1 ]]; then
    warn "Special cases or warnings were logged — inspect $SPECIAL_CASES for details."
else
    ok "Migration finished cleanly with no special cases or warnings."
fi
echo "=================================================="